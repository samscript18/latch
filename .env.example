# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DEMO_MODE=true
HACKATHON_MODE=false

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/latch

# Wallet authentication (server only)
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=900

# Browser-safe application configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only chain configuration
SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_ID=11155111
# ETHOnline 2026 dedicated ENSv2 Sepolia UpgradableUniversalResolverProxy.
# Do not replace it with viem's built-in Sepolia ENS resolver.
ENSV2_UNIVERSAL_RESOLVER_ADDRESS=0xd26f2040d083af1cd2962ba303f4bea0c4faf142
DEMO_ORG_NAME=Acme
DEMO_ORG_ENS=
DEMO_PROCUREMENT_AGENT_ENS=
DEMO_RESEARCH_AGENT_ENS=
DEMO_PROCUREMENT_AGENT_WALLET=
DEMO_RESEARCH_AGENT_WALLET=
ADMIN_WALLET_ADDRESS=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Optional local-only keys for delegated ENS permission evidence. Never commit.
DEMO_PROCUREMENT_AGENT_PRIVATE_KEY=
DEMO_RESEARCH_AGENT_PRIVATE_KEY=

# Planner (Gemini models through Vertex AI Express Mode; server only)
PLANNER_PROVIDER=local
GOOGLE_CLOUD_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Confidential policy (server only)
POLICY_PROVIDER=manual
CRE_ENVIRONMENT=
CRE_POLICY_SECRET_REFERENCE=
CRE_WORKFLOW_URL=
# Local CRE simulation only. Set to the full private-policy JSON in your shell;
# never expose this value through NEXT_PUBLIC_* or commit a populated value.
LATCH_PROCUREMENT_POLICY_ALL=
LATCH_RESEARCH_POLICY_ALL=

# Capability execution (server only)
# local for dashboard development; recipe for the Bazantic-orchestrated bounty path
CAPABILITY_PROVIDER=local
# The in-app Try Now console is separate from the inbound Bazantic Recipe path.
# Use local for deterministic development, or bazantic only when the configured
# gateway exposes the documented outbound search/execute contract.
TRY_NOW_CAPABILITY_PROVIDER=local
BAZANTIC_GATEWAY_URL=
BAZANTIC_RECIPE_ID=
BAZANTIC_API_KEY=

# Research execution (server only)
TAVILY_API_KEY=

# Required in hackathon mode; deployed LatchAudit recorder (server only)
AUDIT_CONTRACT_ADDRESS=
